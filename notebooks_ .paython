    {
      "id": "ace29d6b-afa3-41d7-ac47-0422eebec670",
      "cell_type": "code",
      "source": "class caluculator:\n    def __init__(self,num1,num2):\n        self.num1 = num1\n        self.num2 = num2\n    def add(self):\n        print(\"this sum =\",self.num1+self.num2)\n    def subtract(self):\n        print(\"this subtract =\",self.num1-self.num2)\n    def multiple(self):\n        print(\"this multiple =\",self.num1*self.num2)\n    def divide(self):\n        print(\"this divide =\",self.num1/self.num2)\no1 = caluculator(100,300)\no1.add()\no1.subtract()\no1.multiple()\no1.divide()",
      "metadata": {
        "trusted": true
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": "this sum = 400\nthis subtract = -200\nthis multiple = 30000\nthis divide = 0.3333333333333333\n"
        }
      ],
      "execution_count": 11
    },
