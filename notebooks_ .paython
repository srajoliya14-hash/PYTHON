      "cell_type": "code",
      "source": "class bank:\n    def __init__(self,name,balance):\n        self.name = name\n        self.balance = balance\n        \n    def wid(self,wid_amount):\n        #wid_amount = int(input(\"enter your amount\"))\n        self.balance-=wid_amount\n        print(\" new balance =\",self.balance)\n        \n   \no1 = bank(\"mohit\",10000000)\no1.wid(5600)\n ",
      "metadata": {
        "trusted": true
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": " new balance = 9994400\n"
